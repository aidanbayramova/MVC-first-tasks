<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AndShop</title>
  @*   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"> *@
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet">
    <link href="~/assets/css/bootstap.min.css" rel="stylesheet" />
    @RenderSection("css", required: false)
    <link rel="stylesheet" href="~/assets/css/home/home.css">


</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">
                    <img src="~/assets/img/about/logo about.png" alt="logo" style="height: 70px;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="fa fa-bars"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link " href="#" id="navbarDropdownHome" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Home <i class="fa-solid fa-angle-down"></i>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownHome">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Index" >Fashion</a></li>
                                <li><a class="dropdown-item" href="#">Furnuture</a></li>
                                <li><a class="dropdown-item" href="#">Electronics</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link " href="#" id="navbarDropdownShop" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Shop<i class="fa-solid fa-angle-down"></i>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownShop">
                                <li><a class="dropdown-item" href="#">Shop Layouts</a></li>
                                <li><a class="dropdown-item" href="#">Shop Four Grid</a></li>
                                <li><a class="dropdown-item" href="#">Shop Three Grid</a></li>
                                <li><a class="dropdown-item" href="#">Shop List View</a></li>
                                <li><a class="dropdown-item" asp-controller="Shop" asp-action="Index">Shop Left Sidebar</a></li>
                                <li><a class="dropdown-item" href="#">Shop Right Sidebar</a></li>
                                <li><a class="dropdown-item" href="#">Product Single</a></li>
                                <li><a class="dropdown-item" href="#">Product Single Two</a></li>
                                <li><a class="dropdown-item" href="#">Other Pages</a></li>
                                <li><a class="dropdown-item" href="#">Cart View One</a></li>
                                <li><a class="dropdown-item" href="#">Cart View Two</a></li>
                                <li><a class="dropdown-item" href="#">Empty Cart</a></li>
                                <li><a class="dropdown-item" href="#">Checkout View One</a></li>
                                <li><a class="dropdown-item" href="#">Checkout View Two</a></li>
                                <li><a class="dropdown-item" href="#">Wishlist</a></li>
                                <li><a class="dropdown-item" href="#">Compare</a></li>
                                <li><a class="dropdown-item" href="#">Order Tracking</a></li>
                                <li><a class="dropdown-item" href="#">Order Complete</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" id="navbarDropdownFeature" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Feature<i class="fa-solid fa-angle-down"></i>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownFeature">
                                <li><a class="dropdown-item" href="#">Product Hover</a></li>
                                <li><a class="dropdown-item" href="#">Order Success</a></li>
                                <li><a class="dropdown-item" href="#">Email Template 1</a></li>
                                <li><a class="dropdown-item" href="#">Email Template 2</a></li>
                                <li><a class="dropdown-item" href="#">Email Template 3</a></li>
                                <li><a class="dropdown-item" href="#">LookBook</a></li>
                                <li><a class="dropdown-item" href="#">Invoice 1</a></li>
                                <li><a class="dropdown-item" href="#">Invoice 2</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link " href="#" id="navbarDropdownBlog" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Blog<i class="fa-solid fa-angle-down"></i>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownBlog">
                                <li><a class="dropdown-item" asp-controller="Blog" asp-action="Index">Blog Grid View One</a></li>
                                <li><a class="dropdown-item" href="#">Blog Grid View Two</a></li>
                                <li><a class="dropdown-item" href="">Blog List View</a></li>
                                <li><a class="dropdown-item" href="#">Blog Single View One</a></li>
                                <li><a class="dropdown-item" href="#">Blog Single View Two</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link " href="#" id="navbarDropdownPages" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Pages<i class="fa-solid fa-angle-down"></i>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownPages">
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Index">About Us</a></li>
                                <li><a class="dropdown-item" href="#">Vendor</a></li>
                                <li><a class="dropdown-item" href="#">My Account</a></li>
                                <li><a class="dropdown-item" href="#">Contact Us One</a></li>
                                <li><a class="dropdown-item" href="#">Contact Us Two</a></li>
                                <li><a class="dropdown-item" href="#">Privacy Policy</a></li>
                                <li><a class="dropdown-item" href="#">Coming Soon</a></li>
                                <li><a class="dropdown-item" href="#">Frequently Questions</a></li>
                                <li><a class="dropdown-item" href="#">404 Error</a></li>
                                <li><a class="dropdown-item" href="#">Login</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
                <div class="icons">
                    <div class="position-relative">
                        <i class="fa fa-heart"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="position-relative">
                        <i class="fa fa-shopping-bag"></i>
                        <span class="badge">4</span>
                    </div>
                    <i class="fa fa-search" id="searchIcon"></i>
                    <div class="menu-icon" id="menuBtn">
                        <i class="fa fa-bars"></i>
                    </div>

                </div>
            </div>
        </nav>



        <div class="sidebar" id="sidebar">
            <div class="close-btn" id="closeBtn"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="sidebar-content">
                <img src="~/assets/img/about/logo white.png" alt="logo" style="height: 70px;">
                <p>Address: Your address goes here.</p>
                <p>Call Us: 0123456789, 0123456789</p>
                <p>Email: demo@example.com</p>
                <div class="social-icons">
                    <i class="fa fa-facebook"></i>
                    <i class="fa fa-twitter"></i>
                    <i class="fa fa-instagram"></i>
                    <i class="fa fa-linkedin"></i>
                </div>
                <div class="sidebar-links">
                    <a href="#">Wishlist</a>
                    <a href="#">Cart</a>
                    <a href="#">Checkout</a>
                </div>

            </div>
        </div>



        <div class="new-sidebar" id="newSidebar">
            <div class="close-btn" id="newCloseBtn"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="new-sidebar-content">
                <div class="search-container">
                    <input type="text" id="searchInput" placeholder="type keyword(s) here">
                    <hr id="searchLine">
                    <span id="searchLabel">Search</span>
                </div>
            </div>
        </div>



    </header>
            @RenderBody()
    <footer>
        <div class="row row-cols-xl-4">
            <div class="col">
                <div class="left">
                    <img src="~/assets/img/home/logo.png" alt="">
                    <p>
                        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Obcaecati culpa assumenda voluptas
                        placeat amet consectetur adipisicing elit. Obcaecati culpa assumenda voluptas placeat.
                    </p>
                    <div class="social">
                        <i class="ri-facebook-fill"></i>
                        <i class="ri-twitter-fill"></i>
                        <i class="ri-linkedin-fill"></i>
                        <i class="ri-instagram-line"></i>
                        <i class="ri-google-fill"></i>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="menu">
                    <ul>
                        <li class="title">
                            INFORMATION
                        </li>
                        <li>Home</li>
                        <li>About us</li>
                        <li>Privacy Policy</li>
                        <li>Frequently Questions</li>
                        <li>Order Tracking</li>
                        <li>Compare</li>
                    </ul>
                </div>
            </div>
            <div class="col">
                <div class="right-menu">
                    <ul>
                        <li class="title">SHOP</li>
                        <li>Cart View One</li>
                        <li>Cart View Two</li>
                        <li>Empty Cart</li>
                        <li>Checkout View One</li>
                        <li>Checkout View Two</li>
                        <li>Wishlist</li>
                    </ul>
                </div>
            </div>
            <div class="col">
                <div class="input">
                    <ul>
                        <li class="title">NEWSLETTER</li>
                        <li><input type="text" placeholder="Your Mail*"></li>
                        <li><button>SEND MAIL</button></li>
                    </ul>
                </div>
            </div>
            <div class="sign">
                <h3>© CopyRight 2021 <span>AndShop</span></h3>
                <div class="badge">
                    <img src="~/assets/img/home/cardss.png" alt="">

                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.8/dist/umd/popper.min.js"
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
            integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
            crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/897e067933.js" crossorigin="anonymous"></script>
    @RenderSection("scripts", required:false)
    <script src="./assets/js/home/home.js"></script>
</body>
</html>